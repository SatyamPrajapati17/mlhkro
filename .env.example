# Server Environment Variables (PORT=3002 is strictly required)
PORT=3002
NODE_ENV=development

# Google OAuth (Server-only code flow)
# Authorised JavaScript origin: http://localhost:3002
# Authorised redirect URI: http://localhost:3002/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session / JWT Secret
SESSION_SECRET=

# Supabase (Postgres, RLS, Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI / LLM Configuration (Default: Gemini via Google AI Studio)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Face Recognition Settings
FACE_MATCH_THRESHOLD=0.50
FACE_MARGIN=0.05
FACE_LOCKOUT_MINUTES=15
